{
  "envelope_version": "0.1",
  "machine": { "id": "so-arm101-bob", "class": "tabletop_arm", "mass_kg": 1.4 },
  "level": "A1",
  "workspace": {
    "frame": "base_link",
    "keep_in": [[0.08, -0.20], [0.30, -0.20], [0.30, 0.20], [0.08, 0.20]],
    "keep_out": [],
    "z_range_m": [0.0, 0.25]
  },
  "motion": { "max_speed_mps": 0.25, "max_accel_mps2": 0.5, "max_joint_speed_radps": 3.14 },
  "force": { "max_contact_force_n": 10, "max_payload_kg": 0.5 },
  "proximity": [
    { "when": { "human_within_m": 0.5 }, "max_speed_mps": 0.05 },
    { "when": { "human_within_m": 0.2 }, "action": "stop" }
  ],
  "sensing": { "max_state_age_ms": 100 },
  "stop": { "category": 1, "max_time_ms": 300, "max_distance_m": 0.03 },
  "heartbeat": { "model_timeout_ms": 500, "gate_timeout_ms": 50, "on_loss": "stop" },
  "authority": { "required_for": ["motion", "gripper"], "resolver": "external" }
}
