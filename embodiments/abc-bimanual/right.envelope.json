{
  "envelope_version": "0.1",
  "machine": { "id": "abc-right", "class": "tabletop_arm" },
  "level": "A1",
  "workspace": {
    "frame": "table",
    "keep_in": [[0.10, -0.40], [0.60, -0.40], [0.60, 0.40], [0.10, 0.40]],
    "keep_out": [[[0.10, -0.02], [0.30, -0.02], [0.30, 0.02], [0.10, 0.02]]],
    "z_range_m": [0.0, 0.45]
  },
  "motion": { "max_speed_mps": 0.25, "max_accel_mps2": 0.5 },
  "force": { "max_contact_force_n": 15 },
  "proximity": [
    { "when": { "human_within_m": 1.0 }, "max_speed_mps": 0.10 },
    { "when": { "human_within_m": 0.4 }, "action": "stop" }
  ],
  "sensing": { "max_state_age_ms": 100 },
  "stop": { "category": 1, "max_time_ms": 300, "max_distance_m": 0.05 },
  "heartbeat": { "model_timeout_ms": 500, "gate_timeout_ms": 50, "on_loss": "stop" },
  "authority": { "required_for": ["motion", "gripper"], "resolver": "external" }
}
