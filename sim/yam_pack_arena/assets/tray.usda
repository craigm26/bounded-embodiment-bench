#usda 1.0
(
    defaultPrim = "tray"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "tray" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, 0.01559542)
    float3 physics:diagonalInertia = (0.00050808844, 0.00041178308, 0.0008481679)
    float physics:mass = 0.15

    def Material "physics_material" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 1
        float physics:restitution = 0
        float physics:staticFriction = 1
    }

    def Cube "wall0" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </tray/physics_material> (
            bindMaterialAs = "weakerThanDescendants"
        )
        color3f[] primvars:displayColor = [(0.55, 0.4, 0.25)]
        double size = 2
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.07, 0.08, 0.003)
        double3 xformOp:translate = (0, 0, 0.003)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "wall1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </tray/physics_material> (
            bindMaterialAs = "weakerThanDescendants"
        )
        color3f[] primvars:displayColor = [(0.55, 0.4, 0.25)]
        double size = 2
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.003, 0.08, 0.025)
        double3 xformOp:translate = (0.067, 0, 0.025)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "wall2" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </tray/physics_material> (
            bindMaterialAs = "weakerThanDescendants"
        )
        color3f[] primvars:displayColor = [(0.55, 0.4, 0.25)]
        double size = 2
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.003, 0.08, 0.025)
        double3 xformOp:translate = (-0.067, 0, 0.025)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "wall3" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </tray/physics_material> (
            bindMaterialAs = "weakerThanDescendants"
        )
        color3f[] primvars:displayColor = [(0.55, 0.4, 0.25)]
        double size = 2
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.07, 0.003, 0.025)
        double3 xformOp:translate = (0, 0.077, 0.025)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "wall4" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </tray/physics_material> (
            bindMaterialAs = "weakerThanDescendants"
        )
        color3f[] primvars:displayColor = [(0.55, 0.4, 0.25)]
        double size = 2
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.07, 0.003, 0.025)
        double3 xformOp:translate = (0, -0.077, 0.025)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}

